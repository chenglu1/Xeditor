{
  "name": "@chenglu1/xeditor-editor",
  "version": "0.0.5",
  "private": false,
  "description": "Reusable React rich text and Markdown editor built with Tiptap.",
  "homepage": "https://github.com/chenglu1/Xeditor#readme",
  "bugs": {
    "url": "https://github.com/chenglu1/Xeditor/issues"
  },
  "keywords": [
    "editor",
    "react",
    "tiptap",
    "markdown",
    "rich-text"
  ],
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.esm.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.esm.js"
    },
    "./advanced": {
      "types": "./dist/advanced.d.ts",
      "import": "./dist/advanced.esm.js",
      "require": "./dist/advanced.cjs",
      "default": "./dist/advanced.esm.js"
    },
    "./react-i18next": {
      "types": "./dist/react-i18next.d.ts",
      "import": "./dist/react-i18next.esm.js",
      "require": "./dist/react-i18next.cjs",
      "default": "./dist/react-i18next.esm.js"
    },
    "./styles.css": "./dist/xeditor-editor.css",
    "./styles/core.css": "./dist/styles/core.css",
    "./styles/content.css": "./dist/styles/content.css",
    "./styles/ui.css": "./dist/styles/ui.css",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "**/*.css",
    "**/*.scss"
  ],
  "files": [
    "dist",
    "README.md",
    "MIGRATION.md",
    "USAGE.md"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/chenglu1/Xeditor.git",
    "directory": "packages/editor"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "peerDependencies": {
    "i18next": ">=23.0.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "react-i18next": ">=13.0.0"
  },
  "peerDependenciesMeta": {
    "i18next": {
      "optional": true
    },
    "react-i18next": {
      "optional": true
    }
  },
  "dependencies": {
    "@floating-ui/react": "^0.26.24",
    "@radix-ui/react-popover": "^1.1.0",
    "@tiptap/core": "^3.14.0",
    "@tiptap/extension-character-count": "^3.14.0",
    "@tiptap/extension-details": "^3.14.0",
    "@tiptap/extension-highlight": "^3.14.0",
    "@tiptap/extension-image": "^3.14.0",
    "@tiptap/extension-link": "^3.14.0",
    "@tiptap/extension-list": "^3.14.0",
    "@tiptap/extension-mathematics": "^3.14.0",
    "@tiptap/extension-ordered-list": "^3.14.0",
    "@tiptap/extension-placeholder": "^3.14.0",
    "@tiptap/extension-table": "^3.14.0",
    "@tiptap/extension-table-cell": "^3.14.0",
    "@tiptap/extension-table-header": "^3.14.0",
    "@tiptap/extension-table-row": "^3.14.0",
    "@tiptap/extension-text-align": "^3.14.0",
    "@tiptap/markdown": "^3.14.0",
    "@tiptap/pm": "^3.14.0",
    "@tiptap/react": "^3.14.0",
    "@tiptap/starter-kit": "^3.14.0",
    "katex": "^0.16.21",
    "lodash-es": "^4.17.21",
    "react-hotkeys-hook": "^5.2.1",
    "styled-components": "^6.0.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.3",
    "@vitejs/plugin-react": "^4.7.0",
    "i18next": "^25.10.3",
    "jsdom": "^29.0.1",
    "react-i18next": "^16.6.0",
    "sass": "^1.79.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.21",
    "vitest": "^2.1.9"
  },
  "scripts": {
    "build:types": "tsc -p tsconfig.build.json",
    "build:css": "node ./scripts/build-css.mjs",
    "build:lib": "vite build",
    "build": "pnpm run build:types && pnpm run build:css && pnpm run build:lib",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "prepublishOnly": "pnpm run build",
    "publish:public": "pnpm run build && pnpm publish --access public --no-git-checks"
  }
}
